rules_version = '2';

// -----------------------------------------------------------------------
// IMPORTANT - read before deploying
// -----------------------------------------------------------------------
// No firestore.rules file existed anywhere in this repository before this
// change - whatever rules are live in the Firebase console today are NOT
// under version control here, and this file was NOT reverse-engineered from
// them (this audit has no console access). It was written from the actual
// read/write patterns found in the Flutter client code and the Cloud
// Functions in functions/src/.
//
// Treat this as a first draft, not a drop-in replacement:
//   1. Export or otherwise inspect the CURRENT production rules before you
//      deploy this file, and reconcile any differences deliberately.
//   2. The account-deletion pipeline (functions/src/accountDeletion.ts) and
//      scanGym/notification triggers (functions/src/index.ts) all run with
//      the Admin SDK, which bypasses these rules entirely - they are not
//      affected by anything below.
//   3. Two rules here are deliberately STRICTER than what the current client
//      code does, as part of the payment-safety fix in this same change:
//      - `users/{uid}/subscriptions/{orderId}` is now server-write-only
//        (the client used to write "active" subscriptions directly, which
//        is exactly the un-verified-payment bug this audit flagged).
//      - `users/{uid}` disallows client writes to isPremium/premiumUntil/
//        activePlanId/activeSubscriptionId, for the same reason.
//      A real payment-finalization Cloud Function (Admin SDK) is required
//      to grant premium once JazzCash/EasyPaisa is actually implemented -
//      see PAYMENT_SAFETY_NOTES in plans_controller.dart.
//   4. True admin/moderator access (for reviewing `reports`) needs a custom
//      auth claim (e.g. `request.auth.token.admin == true`) set via the
//      Admin SDK - this repo has no admin tooling to set that claim, so the
//      `isAdmin()` helper below is wired up but nothing grants the claim.
// -----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) &&
        // Premium/subscription state must not be settable by the client -
        // it's only ever written by a trusted backend function.
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'premiumUntil', 'activePlanId', 'activeSubscriptionId']);
      // No client delete - account removal goes through the deletion
      // pipeline, which de-identifies rather than deletes this document.
      allow delete: if false;

      match /settings/{docId} {
        allow read, write: if isSelf(uid);
      }
      match /addresses/{addressId} {
        allow read, write: if isSelf(uid);
      }
      match /notifications/{notifId} {
        allow read, update: if isSelf(uid);
        // Notifications are written server-side by Cloud Functions only.
        allow create, delete: if false;
      }
      match /inbox/{conversationId} {
        allow read, write: if isSelf(uid);
      }
      match /groupMemberships/{groupId} {
        allow read: if isSelf(uid);
        allow write: if false; // maintained by groupRepo/groupInvite transactions server-visible via rules on /groups instead
      }
      match /subscriptions/{orderId} {
        allow read: if isSelf(uid);
        // Server-write-only - see the header note above.
        allow write: if false;
      }
      match /blocks/{blockedUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------------------------------------------------------------
    // Buddy requests & friendships
    // ---------------------------------------------------------------
    match /buddyRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.userIds;
      // Either side of the friendship can end it ("Remove from Buddies",
      // or blocking, which also severs the relationship).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow update: if false;
    }

    // ---------------------------------------------------------------
    // Chat
    // ---------------------------------------------------------------
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)/participants/$(request.auth.uid));
      }
      allow read: if isParticipant();
      allow create: if isSignedIn();
      allow update: if isParticipant();
      allow delete: if false;

      match /participants/{userId} {
        allow read: if isSignedIn();
        allow write: if isSelf(userId) || isSignedIn(); // membership is granted by the inviter/creator too
      }
      match /messages/{messageId} {
        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderUserId == request.auth.uid;
        // Only the author may edit their own message (e.g. the app's own
        // "delete for everyone" redaction, if that's ever added to the UI).
        allow update: if isSignedIn() && resource.data.senderUserId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // Groups
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      function isMember() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      allow read: if isMember();
      allow create: if isSignedIn() && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isMember();
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      match /invites/{inviteId} {
        allow read: if isSignedIn() &&
          (resource.data.invitedUserId == request.auth.uid || resource.data.invitedByUserId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.invitedByUserId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.invitedUserId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // Sessions
    // ---------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdByUserId == request.auth.uid;
      allow delete: if false;

      match /invites/{inviteId} {
        allow read: if isSignedIn() &&
          (resource.data.invitedUserId == request.auth.uid || resource.data.invitedByUserId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.invitedByUserId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.invitedUserId == request.auth.uid;
        allow delete: if false;
      }
      match /participants/{userId} {
        allow read: if isSignedIn();
        allow write: if isSelf(userId);
      }
    }

    // ---------------------------------------------------------------
    // Gym check-ins - server-validated only (scanGym Cloud Function)
    // ---------------------------------------------------------------
    match /scans/{scanId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Reference/content data - public read, admin/console-managed writes
    // ---------------------------------------------------------------
    match /gyms/{gymId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /statsDaily/{dayKey} {
        allow read: if isAdmin();
        allow write: if false; // written by scanGym via Admin SDK
      }
    }
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Moderation
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.reporterUserId == request.auth.uid &&
        request.resource.data.targetUserId != request.auth.uid &&
        reportId.matches(request.auth.uid + '_.*');
      // Reporters may add detail to their own still-open report, but never
      // touch moderation fields - those are admin/Cloud-Function-only.
      allow update: if isSignedIn() &&
        resource.data.reporterUserId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'reviewedBy', 'reviewNotes', 'reporterUserId', 'targetUserId']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Account deletion job status - server-written only, owner-readable
    // ---------------------------------------------------------------
    match /accountDeletions/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
  }
}
